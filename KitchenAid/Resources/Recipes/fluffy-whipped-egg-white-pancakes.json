 "steps": [
  {
   "order": 1,
   "title": null,
   "body": "Whisk the flour, sugar, baking powder, salt, and any spices together in a large bowl.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-1-1"
  },
  {
   "order": 2,
   "title": null,
   "body": "In a second bowl, whisk the buttermilk, egg yolks, melted butter, and vanilla. Pour into the dry ingredients and stir just until combined. A few lumps are fine. If the batter looks very thick, loosen it with a splash of milk.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-2-1"
  },
  {
   "order": 3,
   "title": null,
   "body": "In a tall, clean, dry container, whip the egg whites with the cream of tartar using an immersion blender (whisk attachment works best) until stiff, glossy peaks form, about 3 minutes.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-3-1"
  },
  {
   "order": 4,
   "title": null,
   "body": "Stir a third of the whites into the batter to loosen it, then fold in the rest with a spatula in two additions. Stop while a few white streaks remain. Rest the batter 5 minutes.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-4-1"
  },
  {
   "order": 5,
   "title": null,
   "body": "Heat a nonstick pan or griddle over medium-low and lightly butter it.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-5-1"
  },
  {
   "order": 6,
   "title": "Scoop about 1/3 cup batter per pancake and let it mound tall",
   "body": "Cook until bubbles form and the edges look set, then flip once and cook until golden and cooked through, about 4 minutes total.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "scoop-about-1-3-cup-batter-per-pancake-and-let-it-mound-tall-1"
  },
  {
   "order": 7,
   "title": null,
   "body": "Serve right away, or hold on a rack in a 200 F oven while you finish the batches.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "step-7-1"
  }
 ],
 "notes": [
  "Fluff checklist: use fresh baking powder, weigh or spoon the flour, keep the whites stiff, fold gently, keep the heat at medium-low, and do not press the pancakes after flipping."
