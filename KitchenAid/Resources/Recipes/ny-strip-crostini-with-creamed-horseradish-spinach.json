 "steps": [
  {
   "order": 1,
   "title": "Season the steak",
   "body": "Pat the steak dry and season all over with 1 tsp kosher salt and 1/2 tsp black pepper. Let it sit at room temperature so it sears evenly.",
   "minMinutes": 30,
   "maxMinutes": 30,
   "stepID": "season-the-steak-1"
  },
  {
   "order": 2,
   "title": "Toast the baguette",
   "body": "Heat the oven to 400F. Arrange the baguette slices on a sheet pan, brush with olive oil, and bake until golden and crisp.",
   "minMinutes": 9,
   "maxMinutes": 9,
   "stepID": "toast-the-baguette-1"
  },
  {
   "order": 3,
   "title": "Sear the steak",
   "body": "Heat a heavy skillet over high heat until smoking. Sear the steak 3 to 4 minutes per side for medium rare (125F). In the last minute, add 1 tbsp butter and the smashed garlic and spoon the butter over the steak.",
   "minMinutes": 7,
   "maxMinutes": 8,
   "stepID": "sear-the-steak-1"
  },
  {
   "order": 4,
   "title": "Rest the steak",
   "body": "Move the steak to a board and let it rest. Wipe most of the drippings out of the skillet before the spinach.",
   "minMinutes": 9,
   "maxMinutes": 9,
   "stepID": "rest-the-steak-1"
  },
  {
   "order": 5,
   "title": "Wilt the spinach",
   "body": "In a medium pan over medium heat, melt 1 tbsp butter and cook the shallot for 2 minutes. Add the spinach in handfuls until wilted. Transfer to a clean towel or sieve, squeeze out as much liquid as you can, and roughly chop.",
   "minMinutes": 5,
   "maxMinutes": 5,
   "stepID": "wilt-the-spinach-1"
  },
  {
   "order": 6,
   "title": "Make the creamed spinach",
   "body": "In the same pan over low heat, melt the cream cheese with the heavy cream and horseradish, stirring until smooth. Fold in the spinach, Parmesan, lemon juice, and 1/4 tsp salt. Taste and add more horseradish if you want more heat.",
   "minMinutes": 2,
   "maxMinutes": 2,
   "stepID": "make-the-creamed-spinach-1"
  },
  {
   "order": 7,
   "title": "Slice the steak",
   "body": "Slice the steak thinly against the grain, then cut the slices to fit the crostini.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "slice-the-steak-1"
  },
  {
   "order": 8,
   "title": "Assemble",
   "body": "Spoon warm spinach onto each crostini, top with a slice of steak, and finish with chives and a pinch of flaky salt. Serve right away.",
   "minMinutes": null,
   "maxMinutes": null,
   "stepID": "assemble-1"
  }
 ],
 "notes": [
  "The spinach can be made a day ahead and gently rewarmed with a splash of cream.",
  "Squeezing the spinach dry is the key step. Extra water makes the crostini soggy.",
  "For a sharper bite, stir a little extra horseradish into the spinach just before serving, or add a thin horseradish drizzle on top of the steak.",
  "Toast the baguette just before serving so it stays crisp."
 ],
 "warnings": [],
 "aggregatesWithinRecipe": [
